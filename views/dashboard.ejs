<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShopWise AI — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Same CSS as index.html, but for dashboard */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--neutral-50);
      color: var(--neutral-900);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    :root {
      --accent: #111827;
      --accent-l: #f8fafc;
      --muted: #4b5563;
      --neutral-50:  #fafafa;
      --neutral-100: #f5f5f5;
      --neutral-200: #e5e5e5;
      --neutral-300: #d1d5db;
      --neutral-400: #9ca3af;
      --neutral-500: #6b7280;
      --neutral-600: #4b5563;
      --neutral-700: #374151;
      --neutral-800: #1f2937;
      --neutral-900: #111827;
      --shadow-sm: 0 1px 3px rgba(17, 24, 39, 0.06);
      --shadow:    0 4px 16px rgba(17, 24, 39, 0.08);
      --shadow-lg: 0 10px 30px rgba(17, 24, 39, 0.12);
      --radius:    10px;
      --radius-lg: 20px;
      /* semantic colour tokens */
      --primary:     #111827;
      --primary-l:   #f3f4f6;
      --secondary:   #4b5563;
      --secondary-l: #f8fafc;
      --success:     #059669;
      --success-l:   #ecfdf5;
      --warning:     #d97706;
      --warning-l:   #fffbeb;
      --danger:      #dc2626;
      --danger-l:    #fef2f2;
    }

    .container { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
    .section { padding: 96px 0; }
    .section-sm { padding: 64px 0; }

    /* App Header */
    .app-header {
      background: #fff;
      border-bottom: 1px solid var(--neutral-200);
      position: sticky; top: 0; z-index: 100;
      backdrop-filter: blur(12px);
    }
    .app-nav {
      display: flex; align-items: center; justify-content: space-between;
      height: 64px;
    }
    .app-brand {
      font-size: 18px; font-weight: 800; color: var(--neutral-900);
      letter-spacing: -0.03em;
      text-decoration: none;
    }
    .app-user {
      display: flex; align-items: center; gap: 12px;
      font-size: 14px; color: var(--neutral-600);
    }
    .user-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--neutral-100);
      display: flex; align-items: center; justify-content: center;
    }

    /* Dashboard Layout */
    .dashboard-layout {
      display: grid; grid-template-columns: 280px 1fr; gap: 32px;
      min-height: calc(100vh - 64px);
    }
    .sidebar {
      background: #fff; border-radius: var(--radius); padding: 24px;
      box-shadow: var(--shadow-sm); border: 1px solid var(--neutral-200);
      position: sticky; top: 80px; height: fit-content;
    }
    .sidebar-title {
      font-size: 16px; font-weight: 700; color: var(--neutral-900); margin-bottom: 16px;
    }
    .sidebar-menu {
      list-style: none;
    }
    .sidebar-menu li {
      margin-bottom: 8px;
    }
    .sidebar-menu a {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px; border-radius: 10px;
      text-decoration: none; color: var(--neutral-700);
      transition: all 0.2s;
      font-size: 14px; font-weight: 500;
    }
    .sidebar-menu a:hover, .sidebar-menu a.active {
      background: var(--accent-l); color: var(--accent);
    }
    .sidebar-menu a.active { background: var(--accent-l); }

    .main-content {
      background: #fff; border-radius: var(--radius); padding: 32px;
      box-shadow: var(--shadow-sm); border: 1px solid var(--neutral-200);
    }

    /* Dashboard Content */
    .dash-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 32px;
    }
    .dash-title {
      font-size: 28px; font-weight: 800; color: var(--neutral-900);
    }
    .dash-subtitle {
      font-size: 16px; color: var(--neutral-500); margin-top: 4px;
    }
    .dash-actions {
      display: flex; gap: 12px;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 7px;
      font-family: inherit; font-size: 14px; font-weight: 600;
      padding: 10px 20px; border-radius: 12px;
      border: none; cursor: pointer; transition: all 0.2s;
      text-decoration: none; white-space: nowrap;
    }
    .btn-primary {
      background: var(--accent);
      color: #fff; box-shadow: var(--shadow);
    }
    .btn-primary:hover { opacity: 0.96; box-shadow: var(--shadow-lg); }
    .btn-ghost {
      background: transparent; color: var(--neutral-700);
      border: 1.5px solid var(--neutral-300);
    }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

    /* Score Cards */
    .score-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;
      margin-bottom: 32px;
    }
    .score-card {
      background: #fff; border-radius: var(--radius); padding: 24px;
      box-shadow: var(--shadow-sm); border: 1px solid var(--neutral-200);
      transition: all 0.3s;
    }
    .score-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
    .score-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; margin-bottom: 16px;
    }
    .score-name { font-size: 14px; color: var(--neutral-500); font-weight: 500; margin-bottom: 8px; }
    .score-value { font-size: 32px; font-weight: 800; color: var(--neutral-900); margin-bottom: 8px; }
    .score-bar {
      height: 6px; background: var(--neutral-200); border-radius: 99px;
      margin-bottom: 8px;
    }
    .score-fill { height: 100%; border-radius: 99px; }

    /* Charts and Insights */
    .insights-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
    }
    .insight-card {
      background: #fff; border-radius: var(--radius); padding: 24px;
      box-shadow: var(--shadow-sm); border: 1px solid var(--neutral-200);
    }
    .insight-title {
      font-size: 18px; font-weight: 700; color: var(--neutral-900); margin-bottom: 16px;
    }

    /* Recommendations */
    .recs-list {
      list-style: none;
    }
    .rec-item {
      display: flex; align-items: flex-start; gap: 16px;
      padding: 20px 0; border-bottom: 1px solid var(--neutral-100);
    }
    .rec-item:last-child { border-bottom: none; }
    .rec-icon {
      width: 40px; height: 40px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; flex-shrink: 0;
    }
    .rec-content {}
    .rec-title { font-size: 16px; font-weight: 700; color: var(--neutral-900); margin-bottom: 4px; }
    .rec-desc { font-size: 14px; color: var(--neutral-500); line-height: 1.5; margin-bottom: 8px; }
    .rec-meta { display: flex; gap: 12px; }
    .rec-priority {
      font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 99px;
    }

    /* ─── Mobile burger ─────────────────────────────────────── */
    .burger {
      display: none; background: none; border: none; cursor: pointer;
      padding: 4px; color: var(--neutral-700);
    }
    .burger svg { display: block; }
    .sidebar-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.4); z-index: 49;
    }

    /* ─── Responsive ────────────────────────────────────────── */
    @media (max-width: 900px) {
      .container { padding: 0 20px; }

      .burger { display: flex; align-items: center; }

      .dashboard-layout {
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 16px 0 40px;
      }

      .sidebar {
        position: fixed; top: 0; left: -320px; bottom: 0; z-index: 50;
        width: 280px; border-radius: 0; overflow-y: auto;
        transition: left .25s ease; box-shadow: var(--shadow-lg);
      }
      .sidebar.open { left: 0; }
      .sidebar-overlay.open { display: block; }

      .main-content { border-radius: var(--radius); }

      .dash-header { flex-direction: column; align-items: flex-start; gap: 16px; }
      .dash-actions { width: 100%; }
      .dash-actions .btn { flex: 1; justify-content: center; }

      .score-grid { grid-template-columns: repeat(2, 1fr); }
      .insights-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 480px) {
      .score-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<!-- App Header -->
<header class="app-header">
  <div class="container app-nav">
    <div style="display:flex;align-items:center;gap:12px;">
      <button class="burger" id="burgerBtn" aria-label="Open menu">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="2" y1="6" x2="20" y2="6"/><line x1="2" y1="11" x2="20" y2="11"/><line x1="2" y1="16" x2="20" y2="16"/>
        </svg>
      </button>
      <a href="/" class="app-brand">ShopWise</a>
    </div>
    <div class="app-user">
      <div class="user-avatar">👩‍🍳</div>
      <span><%= shopData.name %></span>
    </div>
  </div>
</header>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Dashboard Layout -->
<div class="container dashboard-layout">

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-title">Dashboard</div>
    <ul class="sidebar-menu">
      <li><a href="/sample/overview" class="<%= shopData.currentSection === 'overview' ? 'active' : '' %>"><span>📊</span> Overview</a></li>
      <li><a href="/sample/location" class="<%= shopData.currentSection === 'location' ? 'active' : '' %>"><span>📍</span> Location</a></li>
      <li><a href="/sample/menu" class="<%= shopData.currentSection === 'menu' ? 'active' : '' %>"><span>🍽️</span> Menu</a></li>
      <li><a href="/sample/competitors" class="<%= shopData.currentSection === 'competitors' ? 'active' : '' %>"><span>⚔️</span> Competitors</a></li>
      <li><a href="/sample/reviews" class="<%= shopData.currentSection === 'reviews' ? 'active' : '' %>"><span>⭐</span> Reviews</a></li>
      <li><a href="/sample/online" class="<%= shopData.currentSection === 'online' ? 'active' : '' %>"><span>🌐</span> Online Presence</a></li>
      <li><a href="/sample/recommendations" class="<%= shopData.currentSection === 'recommendations' ? 'active' : '' %>"><span>📋</span> Recommendations</a></li>
      <li><a href="/sample/progress" class="<%= shopData.currentSection === 'progress' ? 'active' : '' %>"><span>📈</span> Progress</a></li>
    </ul>
  </aside>

  <!-- Main Content -->
  <main class="main-content">

    <% if (shopData.currentSection === 'overview') { %>
    <!-- Header -->
    <div class="dash-header">
      <div>
        <h1 class="dash-title">Business Overview</h1>
        <p class="dash-subtitle">Last updated: May 10, 2026 · AI analysis complete for <%= shopData.name %></p>
      </div>
      <div class="dash-actions">
        <a href="#" class="btn btn-ghost">Export PDF</a>
        <a href="#" class="btn btn-primary">Run New Analysis</a>
      </div>
    </div>

    <!-- Score Cards -->
    <div class="score-grid">
      <div class="score-card">
        <div class="score-icon" style="background: var(--primary-l);">📊</div>
        <div class="score-name">Overall Score</div>
        <div class="score-value"><%= shopData.overallScore %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.overallScore %>%; background: linear-gradient(90deg, var(--primary), var(--secondary));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Good · Room for growth</div>
      </div>
      <div class="score-card">
        <div class="score-icon" style="background: var(--success-l);">📍</div>
        <div class="score-name">Location</div>
        <div class="score-value"><%= shopData.scores.location %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.scores.location %>%; background: linear-gradient(90deg, var(--success), var(--primary));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Excellent visibility</div>
      </div>
      <div class="score-card">
        <div class="score-icon" style="background: var(--warning-l);">🍽️</div>
        <div class="score-name">Menu</div>
        <div class="score-value"><%= shopData.scores.menu %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.scores.menu %>%; background: linear-gradient(90deg, var(--warning), var(--danger));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Needs optimization</div>
      </div>
      <div class="score-card">
        <div class="score-icon" style="background: var(--danger-l);">⚔️</div>
        <div class="score-name">Competitors</div>
        <div class="score-value"><%= shopData.scores.competitors %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.scores.competitors %>%; background: linear-gradient(90deg, var(--danger), var(--warning));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Below average</div>
      </div>
      <div class="score-card">
        <div class="score-icon" style="background: var(--success-l);">⭐</div>
        <div class="score-name">Reviews</div>
        <div class="score-value"><%= shopData.scores.reviews %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.scores.reviews %>%; background: linear-gradient(90deg, var(--success), var(--primary));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Strong performance</div>
      </div>
      <div class="score-card">
        <div class="score-icon" style="background: var(--secondary-l);">🌐</div>
        <div class="score-name">Online Presence</div>
        <div class="score-value"><%= shopData.scores.online %></div>
        <div class="score-bar">
          <div class="score-fill" style="width: <%= shopData.scores.online %>%; background: linear-gradient(90deg, var(--secondary), var(--danger));"></div>
        </div>
        <div style="font-size: 12px; color: var(--neutral-500);">Needs improvement</div>
      </div>
    </div>

    <!-- Insights Grid -->
    <div class="insights-grid">
      <div class="insight-card">
        <h3 class="insight-title">📈 Key Insights</h3>
        <ul style="list-style: none; padding: 0;">
          <li style="padding: 8px 0; border-bottom: 1px solid var(--neutral-100);">
            <strong>Location:</strong> Your spot has excellent foot traffic but lacks visual appeal from the street.
          </li>
          <li style="padding: 8px 0; border-bottom: 1px solid var(--neutral-100);">
            <strong>Menu:</strong> High-quality food but menu presentation could be more compelling.
          </li>
          <li style="padding: 8px 0;">
            <strong>Competitors:</strong> 3 nearby shops are outperforming you in online presence and pricing.
          </li>
        </ul>
      </div>

      <div class="insight-card">
        <h3 class="insight-title">⚡ Top Recommendations</h3>
        <ul class="recs-list">
          <% shopData.recommendations.forEach(rec => { %>
          <li class="rec-item">
            <div class="rec-icon" style="background: <%= rec.bgColor %>;"><%= rec.icon %></div>
            <div class="rec-content">
              <div class="rec-title"><%= rec.title %></div>
              <div class="rec-desc"><%= rec.desc %></div>
              <div class="rec-meta">
                <span class="rec-priority" style="background: <%= rec.bgColor %>; color: var(--accent);"><%= rec.impact %></span>
                <span style="font-size: 12px; color: var(--neutral-500);">Quick to implement</span>
              </div>
            </div>
          </li>
          <% }); %>
        </ul>
      </div>
    </div>
    <% } else if (shopData.currentSection === 'location') { %>
    <div class="dash-header">
      <div>
        <h1 class="dash-title">Location Analysis</h1>
        <p class="dash-subtitle">Detailed insights about your shop's location performance</p>
      </div>
    </div>
    <div class="insight-card" style="max-width: 800px;">
      <h3 class="insight-title">📍 Location Performance</h3>
      <p style="margin-bottom: 20px; color: var(--neutral-600);">Your location scores <%= shopData.scores.location %>/100, indicating excellent foot traffic potential but some visibility challenges.</p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <h4 style="font-weight: 600; margin-bottom: 10px;">Strengths</h4>
          <ul style="color: var(--neutral-600);">
            <li>• High foot traffic area</li>
            <li>• Good proximity to public transport</li>
            <li>• Residential neighborhood with loyal customers</li>
          </ul>
        </div>
        <div>
          <h4 style="font-weight: 600; margin-bottom: 10px;">Areas for Improvement</h4>
          <ul style="color: var(--neutral-600);">
            <li>• Limited street visibility</li>
            <li>• No outdoor seating area</li>
            <li>• Parking availability could be better</li>
          </ul>
        </div>
      </div>
    </div>
    <% } else if (shopData.currentSection === 'menu') { %>
    <div class="dash-header">
      <div>
        <h1 class="dash-title">Menu Analysis</h1>
        <p class="dash-subtitle">Review of your menu design, pricing, and presentation</p>
      </div>
    </div>
    <div class="insight-card" style="max-width: 800px;">
      <h3 class="insight-title">🍽️ Menu Performance</h3>
      <p style="margin-bottom: 20px; color: var(--neutral-600);">Your menu scores <%= shopData.scores.menu %>/100. The food quality is excellent, but presentation and pricing could be optimized.</p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <h4 style="font-weight: 600; margin-bottom: 10px;">Strengths</h4>
          <ul style="color: var(--neutral-600);">
            <li>• High-quality ingredients</li>
            <li>• Authentic flavors</li>
            <li>• Good portion sizes</li>
          </ul>
        </div>
        <div>
          <h4 style="font-weight: 600; margin-bottom: 10px;">Recommendations</h4>
          <ul style="color: var(--neutral-600);">
            <li>• Add more descriptive item names</li>
            <li>• Include high-quality photos</li>
            <li>• Consider price anchoring strategies</li>
          </ul>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="dash-header">
      <div>
        <h1 class="dash-title"><%= shopData.currentSection.charAt(0).toUpperCase() + shopData.currentSection.slice(1) %></h1>
        <p class="dash-subtitle">Analysis for <%= shopData.currentSection %></p>
      </div>
    </div>
    <div class="insight-card" style="max-width: 800px;">
      <h3 class="insight-title"><%= shopData.currentSection.charAt(0).toUpperCase() + shopData.currentSection.slice(1) %> Analysis</h3>
      <p style="color: var(--neutral-600);">Detailed analysis for this section will be available soon.</p>
    </div>
    <% } %>

  </main>

</div>

<script>
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  document.getElementById('burgerBtn').addEventListener('click', () => {
    sidebar.classList.toggle('open');
    overlay.classList.toggle('open');
  });
  overlay.addEventListener('click', () => {
    sidebar.classList.remove('open');
    overlay.classList.remove('open');
  });
</script>
</body>
</html>